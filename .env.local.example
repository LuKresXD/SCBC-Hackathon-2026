# Frontend (Next.js) env — copy to .env.local (gitignored).
# For local dev: keep backend URL pointing at localhost.
# For Vercel production: set NEXT_PUBLIC_BACKEND_URL in the Vercel
# project's Environment Variables UI to the Railway URL, e.g.
#   https://senthos-backend-production.up.railway.app

NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:3001
