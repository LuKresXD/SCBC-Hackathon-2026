{
  "name": "traxis-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Traxis — structured prediction-market products on Solana. Monorepo root for Anchor tests, deploy scripts, and backend wiring.",
  "scripts": {
    "test": "anchor test --skip-local-validator",
    "test:localnet": "anchor test",
    "build": "anchor build",
    "deploy:devnet": "bash scripts/deploy-devnet.sh",
    "init-demo-vaults": "tsx scripts/init-demo-vaults.ts",
    "airdrop": "solana airdrop 2 -u devnet"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.4",
    "@types/bn.js": "^5.1.6",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.9",
    "@types/node": "^22.19.17",
    "bn.js": "^5.2.1",
    "chai": "^4.5.0",
    "dotenv": "^16.4.7",
    "mocha": "^10.8.2",
    "ts-mocha": "^10.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
